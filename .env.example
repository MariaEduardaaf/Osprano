# ---------------------------------------------------------------------------
# sitescout — environment (copy to .env.local and fill in)
# ---------------------------------------------------------------------------

# Convex — created by `npx convex dev` (it writes NEXT_PUBLIC_CONVEX_URL for you)
NEXT_PUBLIC_CONVEX_URL=

# Clerk — dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Set this INSIDE the Convex deployment, not here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
# (Also add a "convex" JWT template in Clerk → JWT Templates.)

# ---- Server-side keys: set these INSIDE the Convex deployment, not here ----
# (Convex actions read process.env; use `npx convex env set NAME value`)
#   GOOGLE_PLACES_API_KEY       — discovery (Places Text Search, New)
#   GOOGLE_PAGESPEED_API_KEY    — Digital Presence Score (optional; PSI works without a key too)
#   ANTHROPIC_API_KEY           — AI outreach drafting
#   APP_URL                     — public app origin for preview links (e.g. http://localhost:3000)
#   RESEND_API_KEY / RESEND_FROM — optional, to send email via Resend
#   FSQ_API_KEY                 — optional, Foursquare discovery (secondary source)
#   STRIPE_SECRET_KEY           — billing (checkout/portal)
#   STRIPE_PRICE_PRO / STRIPE_PRICE_AGENCY — recurring price IDs
#   STRIPE_WEBHOOK_SECRET       — verify webhooks (endpoint: ${CONVEX_SITE_URL}/stripe/webhook)
