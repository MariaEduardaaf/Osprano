# ---------------------------------------------------------------------------
# sitescout — environment (copy to .env.local and fill in)
# ---------------------------------------------------------------------------

# Convex — created by `npx convex dev` (it writes NEXT_PUBLIC_CONVEX_URL for you)
NEXT_PUBLIC_CONVEX_URL=

# Clerk — dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Set this INSIDE the Convex deployment, not here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
# (Also add a "convex" JWT template in Clerk → JWT Templates.)

# ---- Fase 1+ (server-side; add when wiring the pipeline) ----
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PAGESPEED_API_KEY=
# RESEND_API_KEY=
# ANTHROPIC_API_KEY=
